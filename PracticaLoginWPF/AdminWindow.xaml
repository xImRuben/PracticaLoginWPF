<Window x:Class="PracticaLoginWPF.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS DASHBOARD" Height="750" Width="1200"
        Icon="/Assets/logo.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#121212"/>
        <SolidColorBrush x:Key="PanelColor" Color="#1E1E24"/>
        <SolidColorBrush x:Key="AccentColor" Color="#651FFF"/>
        <SolidColorBrush x:Key="TextGray" Color="#888"/>

        <Style x:Key="NexusInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#25252E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="5" Background="#25252E" BorderBrush="#444" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L10,0 L5,6 z" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="NexusComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#25252E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="10,5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#25252E" BorderThickness="1" BorderBrush="#444"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="15,8" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDark}" CornerRadius="12" BorderBrush="#333" BorderThickness="1">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NEXUS" Foreground="White" FontWeight="Black" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text=" ADMIN" Foreground="{StaticResource TextGray}" FontWeight="Light" FontSize="24" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="navUsers" Content="👥 USUARIOS" GroupName="Nav" IsChecked="True" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Users"/>
                    <RadioButton x:Name="navGames" Content="🎮 CATÁLOGO" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="Games"/>

                    <Button Content="📜 LOGS" Click="BtnHistorial_Click" Background="Transparent" Foreground="#AAA" FontWeight="Bold" BorderThickness="1" BorderBrush="#444" Padding="15,8" Margin="10,0,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="📩 APELACIONES" Click="BtnApelaciones_Click" Background="Transparent" Foreground="#AAA" FontWeight="Bold" BorderThickness="1" BorderBrush="#444" Padding="15,8" Margin="10,0,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Click="BtnCerrar_Click" Foreground="#666" Background="Transparent" BorderThickness="0" FontSize="18" Cursor="Hand"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#25252E" CornerRadius="10" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="TOTAL USUARIOS" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblTotal" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1B2E20" CornerRadius="10" Margin="5,0,5,0" Padding="15" BorderBrush="#2E7D32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ACTIVOS AHORA" Foreground="#81C784" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblActivos" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#2E1B1B" CornerRadius="10" Margin="10,0,0,0" Padding="15" BorderBrush="#C62828" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CUENTAS BANEADAS" Foreground="#E57373" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblBaneados" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid x:Name="ViewUsers" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="15" Margin="0,0,25,0">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <TextBlock Text="EDITAR PERFIL" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <Grid HorizontalAlignment="Center" Margin="0,0,0,15">
                                        <Border Width="80" Height="80" CornerRadius="40" BorderBrush="#333" BorderThickness="2" Background="#15151A">
                                            <Image x:Name="imgAvatarPreview" Source="/Assets/logo.ico" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button Click="BtnSubirFoto_Click" Width="24" Height="24" Background="{StaticResource AccentColor}" BorderThickness="0" Cursor="Hand" Content="📷" Foreground="White" FontSize="10"/>
                                            <Button Click="BtnBorrarFoto_Click" Width="24" Height="24" Background="#D32F2F" BorderThickness="0" Cursor="Hand" Content="🗑" Foreground="White" Margin="5,0,0,0" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="txtId" Visibility="Collapsed"/>
                                    <TextBlock Text="Usuario" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                    <TextBox x:Name="txtNombre" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Contraseña" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                    <TextBox x:Name="txtPass" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Email" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                    <TextBox x:Name="txtEmail" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbRol" Grid.Column="0" Margin="0,0,5,0" Height="35" Style="{StaticResource NexusComboStyle}">
                                            <ComboBoxItem Content="admin"/>
                                            <ComboBoxItem Content="user"/>
                                        </ComboBox>
                                        <ComboBox x:Name="cmbEstado" Grid.Column="1" Margin="5,0,0,0" Height="35" Style="{StaticResource NexusComboStyle}">
                                            <ComboBoxItem Content="activo"/>
                                            <ComboBoxItem Content="baneado"/>
                                        </ComboBox>
                                    </Grid>
                                    <Button Content="GUARDAR" Click="BtnGuardar_Click" Height="35" Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Button Content="LIMPIAR" Click="BtnLimpiar_Click" Height="30" Background="#333" Foreground="#AAA" BorderThickness="0"/>
                                    <Separator Background="#333" Margin="0,15"/>
                                    <TextBlock Text="ZONA DE PELIGRO" Foreground="#FF5252" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtMotivo" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,5" Tag="Motivo Baneo"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="DESBANEAR" Click="BtnActivar_Click" Background="#2E7D32" Foreground="White" Height="25" Margin="0,0,2,0"/>
                                        <Button Grid.Column="1" Content="BANEAR" Click="BtnBanear_Click" Background="#C62828" Foreground="White" Height="25" Margin="2,0,0,0"/>
                                    </Grid>
                                    <Button Content="ELIMINAR PERMANENTEMENTE" Click="BtnEliminar_Click" Background="Transparent" Foreground="#FF5252" Height="25" BorderThickness="1" BorderBrush="#FF5252" Margin="0,10,0,0" FontSize="10"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="txtBuscar" Grid.Row="0" Height="40" Style="{StaticResource NexusInputStyle}" TextChanged="TxtBuscar_TextChanged" Margin="0,0,0,15" Background="#15151A"/>
                        <ListBox x:Name="ListaUsuarios" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListaUsuarios_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E24" CornerRadius="10" Width="140" Height="170" Margin="0,0,10,10">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="60" Height="60" CornerRadius="30" Margin="0,0,0,10">
                                                    <Image Source="{Binding AvatarImage, TargetNullValue=/Assets/logo.ico}" Stretch="UniformToFill">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Border>
                                                <TextBlock Text="{Binding Nombre}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Rol}" Foreground="#888" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <Grid x:Name="ViewGames" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="15" Margin="0,0,25,0">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <TextBlock Text="GESTIÓN DE CATÁLOGO" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                                <Border x:Name="brdCaratula" Height="180" Background="#15151A" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#333" BorderThickness="1">
                                    <Image x:Name="imgCaratula" Source="/Assets/logo.ico" Stretch="UniformToFill" Opacity="0.5"/>
                                </Border>
                                <Button Content="📷 SUBIR CARÁTULA" Click="BtnSubirCaratula_Click" Height="30" Background="#333" Foreground="White" Margin="0,0,0,15"/>

                                <TextBox x:Name="txtIdJuego" Visibility="Collapsed"/>
                                <TextBlock Text="Título" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="txtTituloJuego" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Género" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                        <ComboBox x:Name="cmbGeneroJuego" Height="35" Style="{StaticResource NexusComboStyle}" Margin="0,0,0,10">
                                            <ComboBoxItem Content="Acción"/>
                                            <ComboBoxItem Content="Shooter"/>
                                            <ComboBoxItem Content="Carreras"/>
                                            <ComboBoxItem Content="RPG"/>
                                            <ComboBoxItem Content="Estrategia"/>
                                            <ComboBoxItem Content="Terror"/>
                                            <ComboBoxItem Content="Deportes"/>
                                            <ComboBoxItem Content="Aventura"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Precio (€)" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                        <TextBox x:Name="txtPrecioJuego" Style="{StaticResource NexusInputStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Descripción" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtDescJuego" Style="{StaticResource NexusInputStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,10"/>

                                <CheckBox x:Name="chkVisible" Content="Visible en Tienda" Foreground="White" IsChecked="True" Margin="0,0,0,15"/>

                                <Button Content="➕ NUEVO JUEGO" Click="BtnLimpiarJuego_Click" Height="30" Background="#2E7D32" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Button Content="GUARDAR" Click="BtnGuardarJuego_Click" Height="40" Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="LIMPIAR" Click="BtnLimpiarJuego_Click" Height="30" Background="#333" Foreground="#AAA" Margin="0,0,2,0"/>
                                    <Button Grid.Column="1" Content="ELIMINAR" Click="BtnEliminarJuego_Click" Height="30" Background="#D32F2F" Foreground="White" Margin="2,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1">
                        <ListBox x:Name="ListaJuegosAdmin" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListaJuegos_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E24" CornerRadius="10" Width="140" Height="200" Margin="0,0,15,15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2*"/>
                                                <RowDefinition Height="1*"/>
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="10,10,0,0" Grid.Row="0">
                                                <Image Source="{Binding CaratulaImagen, TargetNullValue=/Assets/logo.ico}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
                                                <TextBlock Text="{Binding Titulo}" Foreground="White" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="120" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding PrecioFormato}" Foreground="#651FFF" FontSize="12" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Visible, StringFormat='Visible: {0}'}" Foreground="#666" FontSize="10" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>