<Window x:Class="PracticaLoginWPF.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS DASHBOARD" Height="700" Width="1050"
        Icon="/Assets/logo.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#121212"/>
        <SolidColorBrush x:Key="PanelColor" Color="#1E1E24"/>
        <SolidColorBrush x:Key="AccentColor" Color="#651FFF"/>
        <SolidColorBrush x:Key="TextGray" Color="#888"/>

        <Style x:Key="NexusInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#25252E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NexusButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDark}" CornerRadius="12" BorderBrush="#333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NEXUS" Foreground="White" FontWeight="Black" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text=" CONTROL CENTER" Foreground="{StaticResource TextGray}" FontWeight="Light" FontSize="24" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Click="BtnCerrar_Click" Foreground="#666" Background="Transparent" BorderThickness="0" FontSize="18" Cursor="Hand" VerticalAlignment="Top"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#25252E" CornerRadius="10" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="TOTAL USUARIOS" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblTotal" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1B2E20" CornerRadius="10" Margin="5,0,5,0" Padding="15" BorderBrush="#2E7D32" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ACTIVOS AHORA" Foreground="#81C784" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblActivos" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#2E1B1B" CornerRadius="10" Margin="10,0,0,0" Padding="15" BorderBrush="#C62828" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="CUENTAS BANEADAS" Foreground="#E57373" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="lblBaneados" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelColor}" CornerRadius="10" Padding="15" Margin="0,0,25,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PERFIL" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <Border Width="90" Height="90" CornerRadius="45" BorderBrush="#333" BorderThickness="2" Background="#15151A">
                                        <Image x:Name="imgAvatarPreview" Source="/Assets/logo.ico" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <EllipseGeometry Center="45,45" RadiusX="45" RadiusY="45"/>
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Button Click="BtnSubirFoto_Click" Width="28" Height="28" Background="{StaticResource AccentColor}" BorderThickness="0" Cursor="Hand" Content="📷" Foreground="White"/>
                                        <Button Click="BtnBorrarFoto_Click" Width="28" Height="28" Background="#D32F2F" BorderThickness="0" Cursor="Hand" Content="🗑" Foreground="White" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="txtId" Visibility="Collapsed"/>
                                <TextBlock Text="NOMBRE USUARIO" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="txtNombre" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10"/>
                                <TextBlock Text="CONTRASEÑA" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="txtPass" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10"/>
                                <TextBlock Text="EMAIL" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="txtEmail" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="ROL" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                        <ComboBox x:Name="cmbRol" Height="35">
                                            <ComboBoxItem Content="admin"/>
                                            <ComboBoxItem Content="user"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="ESTADO" Foreground="{StaticResource TextGray}" FontSize="10" FontWeight="Bold"/>
                                        <ComboBox x:Name="cmbEstado" Height="35">
                                            <ComboBoxItem Content="activo"/>
                                            <ComboBoxItem Content="baneado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Button Content="GUARDAR CAMBIOS" Click="BtnGuardar_Click" Height="40" Style="{StaticResource NexusButtonStyle}" Margin="0,0,0,10"/>
                                <Button Content="LIMPIAR CAMPOS" Click="BtnLimpiar_Click" Height="30" Background="#333" Foreground="#AAA" BorderThickness="0" Cursor="Hand"/>

                                <Separator Background="#333" Margin="0,15"/>

                                <Border BorderBrush="#444" BorderThickness="1" CornerRadius="8" Padding="12" Background="#15151A">
                                    <StackPanel>
                                        <TextBlock Text="CONTROL DE BANEOS" Foreground="#FF5252" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBox x:Name="txtMotivo" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,10" Tag="Motivo"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="ACTIVAR" Click="BtnActivar_Click" Background="#2E7D32" Foreground="White" Height="30" Margin="0,0,5,0"/>
                                            <Button Grid.Column="1" Content="BANEAR" Click="BtnBanear_Click" Background="#C62828" Foreground="White" Height="30" Margin="5,0,0,0"/>
                                        </Grid>
                                        <Button Content="ELIMINAR PERMANENTEMENTE" Click="BtnEliminar_Click" Background="Transparent" Foreground="#FF5252" Height="30" BorderThickness="1" BorderBrush="#FF5252" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="📜 HISTORIAL" Click="BtnHistorial_Click" Width="135" Height="35" Background="#303040" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="📩 APELACIONES" Click="BtnApelaciones_Click" Width="135" Height="35" Background="#303040" Foreground="White" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBox x:Name="txtBuscar" Height="40" Style="{StaticResource NexusInputStyle}" TextChanged="TxtBuscar_TextChanged" Background="#15151A" BorderThickness="0"/>
                        <TextBlock Text="🔍 Buscar usuario..." Foreground="#444" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscar}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox x:Name="ListaUsuarios" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListaUsuarios_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E24" CornerRadius="12" BorderBrush="#333" BorderThickness="1" Width="150" Height="180" Margin="0,0,15,15">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="60" Height="60" Margin="0,0,0,10">
                                            <Border CornerRadius="30">
                                                <Image Source="{Binding AvatarImage, TargetNullValue=/Assets/logo.ico}" Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>
                                            <Border Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="2" BorderBrush="#1E1E24">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="activo">
                                                                <Setter Property="Background" Value="#00E676"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="baneado">
                                                                <Setter Property="Background" Value="#FF1744"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Nombre}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,5,0,0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Rol}" Foreground="#AAA" FontSize="10"/>
                                        </Border>
                                        <TextBlock Text="{Binding Id, StringFormat='ID: #{0}'}" Foreground="#555" FontSize="9" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>