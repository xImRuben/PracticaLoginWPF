<Window x:Class="PracticaLoginWPF.GameLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lanzando Juego" Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="15" ClipToBounds="True">
        <Grid>
            <Image x:Name="imgFondo" Stretch="UniformToFill" Opacity="0.4"/>
            <Border Background="#CC000000"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="INICIANDO..." Foreground="#AAA" FontSize="12" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtTitulo" Text="NOMBRE JUEGO" Foreground="White" FontWeight="Black" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Grid Width="400" Height="6">
                    <Border Background="#333" CornerRadius="3"/>
                    <Border x:Name="barraProgreso" HorizontalAlignment="Left" Width="0" Background="#00E676" CornerRadius="3"/>
                </Grid>

                <TextBlock x:Name="txtPorcentaje" Text="0%" Foreground="#00E676" FontSize="12" HorizontalAlignment="Right" Margin="0,5,30,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>