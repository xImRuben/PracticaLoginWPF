<Window x:Class="PracticaLoginWPF.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Loading" Height="350" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentColor" Color="#5028F0"/>
    </Window.Resources>

    <Border Background="#050505" CornerRadius="20" BorderBrush="#333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Image Source="/Assets/login_bg.jpg" Stretch="UniformToFill" Opacity="0.1"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <Grid Width="100" Height="110" Margin="0,0,0,30">
                    <Path Data="M 50,0 L 93.3,25 L 93.3,75 L 50,100 L 6.7,75 L 6.7,25 Z"
                          Fill="{StaticResource AccentColor}" Opacity="0.2">
                        <Path.Effect>
                            <BlurEffect Radius="30"/>
                        </Path.Effect>
                    </Path>
                    <Path Data="M 50,0 L 93.3,25 L 93.3,75 L 50,100 L 6.7,75 L 6.7,25 Z"
                          Stroke="{StaticResource AccentColor}" StrokeThickness="3" Fill="#101015"/>
                    <Image Source="/Assets/logo.ico" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="NEXUS" Foreground="White" FontSize="40" FontWeight="Black" HorizontalAlignment="Center" />
                <TextBlock Text="SYSTEM INITIALIZATION" Foreground="{StaticResource AccentColor}" FontSize="10" HorizontalAlignment="Center"  Margin="0,5,0,30" Opacity="0.8"/>

                <Grid Width="400" Height="6">
                    <Border Background="#222" CornerRadius="3"/>
                    <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentColor}" CornerRadius="3">
                        <Border.Effect>
                            <DropShadowEffect Color="#5028F0" BlurRadius="10" ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>
                </Grid>

                <TextBlock x:Name="txtLoading" Text="Cargando componentes..." Foreground="#666" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            </StackPanel>

            <TextBlock Text="v3.0 Ultimate" Foreground="#333" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,15"/>
        </Grid>
    </Border>
</Window>