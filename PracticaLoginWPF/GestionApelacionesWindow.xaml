<Window x:Class="PracticaLoginWPF.GestionApelacionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Apelaciones" Height="500" Width="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent" MouseDown="Window_MouseDown">

    <Border Background="#1A1A24" CornerRadius="15" BorderBrush="#651FFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="📩 SOLICITUDES DE DESBANEO" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Content="✖" HorizontalAlignment="Right" Click="BtnCerrar_Click" Foreground="Gray" Background="Transparent" BorderThickness="0" FontSize="20" Cursor="Hand" VerticalAlignment="Top"/>

            <DataGrid x:Name="GridApelaciones" Grid.Row="1" AutoGenerateColumns="False" 
                      Background="Transparent" 
                      RowBackground="#1E1E24" 
                      AlternatingRowBackground="#25252E"
                      Foreground="White" 
                      BorderThickness="0"
                      HeadersVisibility="Column" 
                      IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#333">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#222"/>
                        <Setter Property="Foreground" Value="#AAA"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="#333"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>

                    <DataGridTextColumn Header="USUARIO" Binding="{Binding usuario}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#651FFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="MOTIVO APELACIÓN" Binding="{Binding texto_apelacion}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="FECHA" Binding="{Binding fecha}" Width="140"/>

                    <DataGridTemplateColumn Header="ACCIONES" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✓ ACEPTAR" Click="BtnAceptar_Click" Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="10" Margin="0,0,5,0" Padding="10,5" BorderThickness="0" Cursor="Hand" Tag="{Binding id_usuario}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="✕ RECHAZAR" Click="BtnRechazar_Click" Background="#C62828" Foreground="White" FontWeight="Bold" FontSize="10" Padding="10,5" BorderThickness="0" Cursor="Hand" Tag="{Binding id}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="txtSinDatos" Text="No hay solicitudes pendientes." Foreground="#666" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" FontSize="14" FontStyle="Italic"/>
        </Grid>
    </Border>
</Window>