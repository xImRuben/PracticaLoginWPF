<Window x:Class="PracticaLoginWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Login" Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="/Assets/logo.ico"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PurpleAccent" Color="#5028F0"/>
        <SolidColorBrush x:Key="InputBg" Color="#18181C"/>
        <SolidColorBrush x:Key="TextLabel" Color="#888899"/>

        <Style x:Key="NexusInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PurpleAccent}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#5028F0" BlurRadius="10" Opacity="0.3" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NexusPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A2A35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PurpleAccent}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#5028F0" BlurRadius="10" Opacity="0.3" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NexusCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextLabel}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" BorderBrush="#333" BorderThickness="1" Background="#18181C" Margin="0,0,8,0">
                                <Path x:Name="mark" Data="M 3,8 L 6,11 L 13,4" Stroke="{StaticResource PurpleAccent}" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource PurpleAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NexusLoginButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PurpleAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6038FF"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#6038FF" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" ClipToBounds="True" BorderBrush="#222" BorderThickness="1">
        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.4" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#1A1A22" Offset="0"/>
                <GradientStop Color="#0A0A0C" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,0,40">
                    <Grid Width="80" Height="90" Margin="0,0,0,25">
                        <Path Data="M 40,0 L 74.6,20 L 74.6,60 L 40,80 L 5.4,60 L 5.4,20 Z"
                              Fill="{StaticResource PurpleAccent}" Opacity="0.2">
                            <Path.Effect>
                                <BlurEffect Radius="30"/>
                            </Path.Effect>
                        </Path>
                        <Path Data="M 40,0 L 74.6,20 L 74.6,60 L 40,80 L 5.4,60 L 5.4,20 Z"
                              Stroke="{StaticResource PurpleAccent}" StrokeThickness="1.5" Fill="#121215"/>
                        <Image Source="/Assets/logo.ico" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="NEXUS" Foreground="White" FontSize="46" FontWeight="Black" HorizontalAlignment="Center" />
                    <Border Background="#5028F0" CornerRadius="6" Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Center" Opacity="0.9">
                        <TextBlock Text="CONNECTING WORLDS" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <Grid Grid.Column="1" Margin="50,35,50,30">
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnCerrar_Click" 
                            Foreground="#666" Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" Margin="0,-10,-20,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel VerticalAlignment="Center" Margin="0,15,0,0">
                        <TextBlock Text="Iniciar Sesión" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,35"/>

                        <TextBlock Text="ID DE USUARIO" Foreground="{StaticResource TextLabel}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtUser" Height="45" Style="{StaticResource NexusInputStyle}" Margin="0,0,0,25"/>

                        <TextBlock Text="CLAVE DE ACCESO" Foreground="{StaticResource TextLabel}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="txtPass" Height="45" Style="{StaticResource NexusPasswordStyle}" Margin="0,0,0,20"/>

                        <CheckBox x:Name="chkRecordar" Content="Recordar mi usuario" Style="{StaticResource NexusCheckBox}" Margin="0,0,0,25"/>

                        <Border x:Name="PanelError" Background="#2A1010" BorderBrush="#FF4444" BorderThickness="1" CornerRadius="6" Margin="0,0,0,25" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="12">
                                <TextBlock Text="⚠️" Foreground="#FF4444" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Acceso Denegado" Foreground="#FF4444" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="txtError" Text="Motivo..." Foreground="#FFaaaa" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="ENTRAR" Click="BtnLogin_Click" Height="45" Style="{StaticResource NexusLoginButton}" Margin="0,0,0,25"/>

                        <TextBlock HorizontalAlignment="Center" FontSize="12">
                            <Run Text="¿No tienes cuenta?" Foreground="{StaticResource TextLabel}"/>
                            <Hyperlink Click="BtnRegister_Click" TextDecorations="None">
                                <Run Text="Regístrate aquí" Foreground="White"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="v3.0 Ultimate" Foreground="{StaticResource TextLabel}" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0.5"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>