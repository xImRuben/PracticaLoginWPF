<Window x:Class="PracticaLoginWPF.ApelacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centro de Apelaciones" Height="460" Width="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent" MouseDown="Window_MouseDown">

    <Border Background="#1A1A24" CornerRadius="15" BorderBrush="#FF5252" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.8"/>
        </Border.Effect>

        <Grid Margin="25">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="⚖️ TRIBUNAL DE NEXUS" Foreground="#FF5252" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="FORMULARIO DE APELACIÓN" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Usuario Afectado:" Foreground="White" FontWeight="Bold"/>
                <TextBox x:Name="txtUsuario" IsReadOnly="True" Background="#222" Foreground="White" BorderThickness="0" Padding="5" Margin="0,5,0,15" Opacity="0.7"/>

                <TextBlock Text="Explica por qué deberíamos levantarte el castigo:" Foreground="White" FontWeight="Bold"/>
                <TextBox x:Name="txtMensaje" Height="140" TextWrapping="Wrap" AcceptsReturn="True" 
                         Background="#25252E" Foreground="White" BorderBrush="#444" BorderThickness="1" 
                         Padding="10" Margin="0,5,0,20" VerticalContentAlignment="Top"/>

                <Button Content="ENVIAR APELACIÓN" Click="BtnEnviar_Click" Height="45" Background="#FF5252" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Cancelar y Salir" Click="BtnCancelar_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,15,0,0" Cursor="Hand" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>