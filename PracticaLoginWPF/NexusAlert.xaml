<Window x:Class="PracticaLoginWPF.NexusAlert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerta Nexus" Height="250" Width="450"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">

    <Border Background="#1A1A24" CornerRadius="12" BorderBrush="#FF5252" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="⛔ ACCESO DENEGADO" Foreground="#FF5252" FontSize="18" FontWeight="Black" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtMensaje" Text="Mensaje de error..." Foreground="White" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="¿Deseas enviar una apelación?" Foreground="#AAA" TextAlignment="Center" FontSize="12" FontStyle="Italic"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="SÍ, APELAR" Click="BtnSi_Click" Width="120" Height="35" Background="#FF5252" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="NO, SALIR" Click="BtnNo_Click" Width="120" Height="35" Background="#333" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>