<Window x:Class="PracticaLoginWPF.NexusMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Message" Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="#1E1E24" CornerRadius="15" BorderBrush="#651FFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="NEXUS" Foreground="#651FFF" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text=" INFO" Foreground="White" FontWeight="Light" FontSize="16"/>
            </StackPanel>

            <TextBlock x:Name="txtMensaje" Grid.Row="1" Text="Mensaje aquí..." 
                       Foreground="#DDD" TextWrapping="Wrap" TextAlignment="Center" 
                       VerticalAlignment="Center" FontSize="14"/>

            <Button Grid.Row="2" Content="ACEPTAR" Click="BtnAceptar_Click" 
                    Height="40" Width="120" Background="#651FFF" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>